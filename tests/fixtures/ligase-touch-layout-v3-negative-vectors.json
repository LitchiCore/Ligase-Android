{
  "schemaVersion": 3,
  "documentCases": [
    {
      "id": "uppercase-layout-uuid",
      "mutations": [
        {
          "path": "/layoutId",
          "value": "00000000-0000-0000-0000-00000000000A"
        }
      ],
      "expected": "schemaRejected"
    },
    {
      "id": "non-d-layout-uuid",
      "mutations": [
        {
          "path": "/layoutId",
          "value": "{00000000-0000-0000-0000-000000000001}"
        }
      ],
      "expected": "schemaRejected"
    },
    {
      "id": "unsafe-revision",
      "mutations": [
        {
          "path": "/revision",
          "value": 9007199254740992
        }
      ],
      "expected": "schemaRejected"
    },
    {
      "id": "missing-next-keyboard-batch-ordinal",
      "mutations": [
        {
          "op": "delete",
          "path": "/nextKeyboardBatchOrdinal"
        }
      ],
      "expected": "schemaRejected"
    },
    {
      "id": "zero-next-keyboard-batch-ordinal",
      "mutations": [
        {
          "path": "/nextKeyboardBatchOrdinal",
          "value": 0
        }
      ],
      "expected": "schemaRejected"
    },
    {
      "id": "duplicate-variant",
      "mutations": [
        {
          "op": "append",
          "path": "/variants",
          "valueFrom": "/variants/0"
        }
      ],
      "rehash": true,
      "expected": "invalidVariantId"
    },
    {
      "id": "duplicate-element",
      "mutations": [
        {
          "op": "append",
          "path": "/variants/0/elements",
          "valueFrom": "/variants/0/elements/0"
        }
      ],
      "rehash": true,
      "expected": "duplicateElementId"
    },
    {
      "id": "noncanonical-variant-order",
      "mutations": [
        {
          "op": "append",
          "path": "/variants",
          "valueFrom": "/variants/0"
        },
        {
          "path": "/variants/0/variantId",
          "value": "00000000-0000-0000-0000-000000000020"
        },
        {
          "path": "/variants/1/variantId",
          "value": "00000000-0000-0000-0000-000000000010"
        }
      ],
      "rehash": true,
      "expected": "nonCanonicalVariantOrder"
    },
    {
      "id": "noncanonical-device-class-order",
      "mutations": [
        {
          "path": "/variants/0/deviceClasses",
          "value": [
            "tablet",
            "phone"
          ]
        }
      ],
      "rehash": true,
      "expected": "nonCanonicalSetOrder"
    },
    {
      "id": "noncanonical-orientation-order",
      "mutations": [
        {
          "path": "/variants/0/orientations",
          "value": [
            "landscape",
            "portrait"
          ]
        }
      ],
      "rehash": true,
      "expected": "nonCanonicalSetOrder"
    },
    {
      "id": "invalid-ratio-order",
      "mutations": [
