{
  "schemaVersion": 2,
  "documentCases": [
    {
      "id": "uppercase-layout-uuid",
      "mutations": [{"path": "/layoutId", "value": "00000000-0000-0000-0000-00000000000A"}],
      "expected": "schemaRejected"
    },
    {
      "id": "non-d-layout-uuid",
      "mutations": [{"path": "/layoutId", "value": "{00000000-0000-0000-0000-000000000001}"}],
      "expected": "schemaRejected"
    },
    {
      "id": "unsafe-revision",
      "mutations": [{"path": "/revision", "value": 9007199254740992}],
      "expected": "schemaRejected"
    },
    {
      "id": "duplicate-variant",
      "mutations": [{"op": "append", "path": "/variants", "valueFrom": "/variants/0"}],
      "rehash": true,
      "expected": "invalidVariantId"
    },
    {
      "id": "duplicate-element",
      "mutations": [{"op": "append", "path": "/variants/0/elements", "valueFrom": "/variants/0/elements/0"}],
      "rehash": true,
      "expected": "duplicateElementId"
    },
    {
      "id": "noncanonical-variant-order",
      "mutations": [
        {"op": "append", "path": "/variants", "valueFrom": "/variants/0"},
        {"path": "/variants/0/variantId", "value": "00000000-0000-0000-0000-000000000020"},
        {"path": "/variants/1/variantId", "value": "00000000-0000-0000-0000-000000000010"}
      ],
      "rehash": true,
      "expected": "nonCanonicalVariantOrder"
    },
    {
      "id": "noncanonical-device-class-order",
      "mutations": [{"path": "/variants/0/deviceClasses", "value": ["tablet", "phone"]}],
      "rehash": true,
      "expected": "nonCanonicalSetOrder"
    },
    {
      "id": "noncanonical-orientation-order",
      "mutations": [{"path": "/variants/0/orientations", "value": ["landscape", "portrait"]}],
      "rehash": true,
      "expected": "nonCanonicalSetOrder"
    },
    {
      "id": "invalid-ratio-order",
      "mutations": [{"path": "/variants/0/recommendation/minAspectRatio", "value": {"numerator": 4, "denominator": 1}}],
      "rehash": true,
      "expected": "invalidAspectRange"
    },
    {
      "id": "elements-513",
      "mutations": [{"op": "repeatAppend", "path": "/variants/0/elements", "valueFrom": "/variants/0/elements/0", "count": 503}],
      "expected": "schemaRejected"
    },
    {
      "id": "variants-33",
      "mutations": [{"op": "repeatAppend", "path": "/variants", "valueFrom": "/variants/0", "count": 32}],
      "expected": "schemaRejected"
    },
    {
      "id": "extensions-33",
      "mutations": [{"op": "fillObject", "path": "/extensions", "value": true, "count": 33}],
      "expected": "schemaRejected"
    },
    {
      "id": "extension-items-33",
      "mutations": [{"op": "fillArray", "path": "/extensions/x", "value": true, "count": 33}],
      "expected": "schemaRejected"
    },
    {
      "id": "extension-fraction",
      "mutations": [{"path": "/extensions", "value": {"x": 1.5}}],
      "expected": "schemaRejected"
    },
    {
      "id": "extension-unsafe-integer",
      "mutations": [{"path": "/extensions", "value": {"x": 9007199254740992}}],
      "expected": "schemaRejected"
    },
    {
      "id": "extension-depth-seven",
      "mutations": [{"path": "/extensions", "value": {"a": {"b": {"c": {"d": {"e": {"f": {"g": {"h": true}}}}}}}}}],
      "rehash": true,
      "expected": "schemaRejected"
    },
    {
      "id": "invalid-unicode-surrogate",
      "mutations": [{"path": "/displayName", "value": "\ud800"}],
      "expected": "invalidString"
    },
    {
      "id": "source-reference-too-long",
      "mutations": [{"path": "/variants/0/elements/0/sourceReference", "value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}],
      "expected": "schemaRejected"
    },
    {
      "id": "unknown-input-namespace",
      "mutations": [{"path": "/variants/0/elements/0/payload/inputCode/namespace", "value": "windowsVirtualKey"}],
      "expected": "schemaRejected"
    },
    {
      "id": "missing-input-code",
      "mutations": [{"op": "delete", "path": "/variants/0/elements/0/payload/inputCode"}],
      "expected": "schemaRejected"
    },
    {
      "id": "invalid-mouse-button",
      "mutations": [{"path": "/variants/0/elements/1/payload/button", "value": 9}],
      "expected": "schemaRejected"
    },
    {
      "id": "analog-diagonal-policy",
      "mutations": [{"path": "/variants/0/elements/2/payload/diagonalPolicy", "value": "dominantAxis"}],
      "expected": "schemaRejected"
    },
    {
      "id": "dpad-missing-direction",
      "mutations": [{"op": "delete", "path": "/variants/0/elements/3/payload/right"}],
      "expected": "schemaRejected"
    },
    {
      "id": "sticky-trigger-conflict",
      "mutations": [
        {"path": "/variants/0/elements/4/payload/sticky", "value": true},
        {"path": "/variants/0/elements/4/payload/trigger", "value": "hold"}
      ],
      "rehash": true,
      "expected": "stickyTriggerConflict"
    },
    {
      "id": "radial-boundary-unknown",
      "mutations": [{"path": "/variants/0/elements/5/payload/boundaryPolicy", "value": "nearest"}],
      "expected": "schemaRejected"
    },
    {
      "id": "scroll-continuous-missing-cadence",
      "mutations": [{"path": "/variants/0/elements/6/payload/cadenceMs", "value": null}],
      "rehash": true,
      "expected": "invalidScrollCadence"
    },
    {
      "id": "combo-release-order",
      "mutations": [{"path": "/variants/0/elements/7/payload/releaseOrder", "value": "listed"}],
      "expected": "schemaRejected"
    },
    {
      "id": "soft-keyboard-nonlocal",
      "mutations": [{"path": "/variants/0/elements/8/payload/executionScope", "value": "host"}],
      "expected": "schemaRejected"
    },
    {
      "id": "gyro-target-unknown",
      "mutations": [{"path": "/variants/0/elements/9/payload/target", "value": "leftStick"}],
      "expected": "schemaRejected"
    },
    {
      "id": "gyro-scale-out-of-range",
      "mutations": [{"path": "/variants/0/elements/9/payload/scale", "value": 100001}],
      "expected": "schemaRejected"
    },
    {
      "id": "timed-hold-missing-duration",
      "mutations": [
        {"path": "/variants/0/elements/0/payload/trigger", "value": "timedHold"},
        {"path": "/variants/0/elements/0/payload/timedHoldMs", "value": null}
      ],
      "rehash": true,
      "expected": "invalidTimedHold"
    },
    {
      "id": "non-timed-hold-has-duration",
      "mutations": [{"path": "/variants/0/elements/0/payload/timedHoldMs", "value": 500}],
      "rehash": true,
      "expected": "unexpectedTimedHold"
    },
    {
      "id": "active-overlap-same-z",
      "mutations": [
        {"path": "/variants/0/elements/1/zOrder", "value": 0},
        {"path": "/variants/0/elements/1/rect", "value": {"x": 20, "y": 20, "width": 80, "height": 80}}
      ],
      "rehash": true,
      "expected": "ambiguousCollision"
    },
    {
      "id": "boundary-touch-is-not-overlap",
      "mutations": [
        {"path": "/variants/0/elements/1/zOrder", "value": 0},
        {"path": "/variants/0/elements/1/rect", "value": {"x": 100, "y": 20, "width": 80, "height": 80}}
      ],
      "rehash": true,
      "expected": "accepted"
    },
    {
      "id": "disabled-overlap-allowed",
      "mutations": [
        {"path": "/variants/0/elements/1/zOrder", "value": 0},
        {"path": "/variants/0/elements/1/enabled", "value": false},
        {"path": "/variants/0/elements/1/rect", "value": {"x": 20, "y": 20, "width": 80, "height": 80}}
      ],
      "rehash": true,
      "expected": "accepted"
    },
    {
      "id": "hash-mismatch",
      "mutations": [{"path": "/displayName", "value": "Changed"}],
      "expected": "contentHashMismatch"
    }
  ],
  "rawCases": [
    {
      "id": "invalid-utf8",
      "hex": "ff",
      "expected": "invalidUtf8"
    },
    {
      "id": "duplicate-core-field",
      "hex": "7b22666f726d6174223a2278222c22666f726d6174223a2278227d",
      "expected": "duplicateKey"
    },
    {
      "id": "duplicate-nested-field",
      "hex": "7b2276617269616e74223a7b226964223a312c226964223a317d7d",
      "expected": "duplicateKey"
    },
    {
      "id": "negative-zero-artifact-integer",
      "hex": "7b227265766973696f6e223a2d307d",
      "expected": "negativeZero"
    },
    {
      "id": "negative-zero-nested-extension",
      "hex": "7b22657874656e73696f6e73223a7b2278223a2d307d7d",
      "expected": "negativeZero"
    }
  ],
  "jcsCases": [
    {
      "id": "utf16-non-bmp-key-order",
      "input": {"": 1, "😀": 2},
      "expected": "{\"😀\":2,\"\":1}"
    },
    {
      "id": "integer-and-control-escape",
      "input": {"z": -5, "a": "line\nfeed"},
      "expected": "{\"a\":\"line\\nfeed\",\"z\":-5}"
    }
  ],
  "viewportCases": [
    {
      "id": "video-content-center-anchor-round-half-up",
      "canvas": {"width": 100, "height": 100},
      "element": {
        "rect": {"x": 10, "y": 20, "width": 20, "height": 30},
        "horizontalAnchor": "center",
        "verticalAnchor": "center"
      },
      "videoContentRect": {"x": 0, "y": 0, "width": 201, "height": 100},
      "systemSafeRect": {"x": 0, "y": 0, "width": 201, "height": 100},
      "safeAreaPolicy": "videoContent",
      "expectedRect": {"x": 61, "y": 20, "width": 20, "height": 30}
    },
    {
      "id": "system-inset-intersection",
      "canvas": {"width": 100, "height": 100},
      "element": {
        "rect": {"x": 0, "y": 0, "width": 20, "height": 20},
        "horizontalAnchor": "left",
        "verticalAnchor": "top"
      },
      "videoContentRect": {"x": 0, "y": 0, "width": 200, "height": 100},
      "systemSafeRect": {"x": 20, "y": 10, "width": 160, "height": 80},
      "safeAreaPolicy": "videoContentAndSystemInsets",
      "expectedRect": {"x": 20, "y": 10, "width": 16, "height": 16}
    },
    {
      "id": "degenerate-safe-area",
      "canvas": {"width": 100, "height": 100},
      "element": {
        "rect": {"x": 0, "y": 0, "width": 20, "height": 20},
        "horizontalAnchor": "left",
        "verticalAnchor": "top"
      },
      "videoContentRect": {"x": 0, "y": 0, "width": 100, "height": 100},
      "systemSafeRect": {"x": 100, "y": 0, "width": 10, "height": 10},
      "safeAreaPolicy": "videoContentAndSystemInsets",
      "expectedError": "incompatibleSafeArea"
    }
  ],
  "descriptorCases": [
    {
      "id": "descriptor-exact-touch-variant",
      "descriptor": {
        "layoutId": "00000000-0000-0000-0000-000000000001",
        "revision": 1,
        "variants": [
          {
            "variantId": "00000000-0000-0000-0000-000000000002",
            "inputProfile": "touch",
            "deviceClasses": ["phone"],
            "orientations": ["landscape"]
          },
          {
            "variantId": "00000000-0000-0000-0000-000000000099",
            "inputProfile": "gamepad",
            "deviceClasses": ["phone"],
            "orientations": ["landscape"]
          }
        ]
      },
      "expected": "accepted"
    },
    {
      "id": "descriptor-touch-variant-missing",
      "descriptor": {
        "layoutId": "00000000-0000-0000-0000-000000000001",
        "revision": 1,
        "variants": []
      },
      "expected": "descriptorVariantSetMismatch"
    },
    {
      "id": "descriptor-device-class-mismatch",
      "descriptor": {
        "layoutId": "00000000-0000-0000-0000-000000000001",
        "revision": 1,
        "variants": [
          {
            "variantId": "00000000-0000-0000-0000-000000000002",
            "inputProfile": "touch",
            "deviceClasses": ["tablet"],
            "orientations": ["landscape"]
          }
        ]
      },
      "expected": "descriptorEligibilityMismatch"
    }
  ],
